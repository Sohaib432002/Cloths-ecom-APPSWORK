AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (optional). Without these, a local SQLite file is created at data/veora.db.
# DATABASE_PATH=./data/veora.db
# Turso (hosted SQLite, free tier) for a persistent database on serverless hosts such as Vercel:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# AI stylist (optional, falls back to catalog matching)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
