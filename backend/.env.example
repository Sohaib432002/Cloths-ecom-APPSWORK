# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Karachi
DJANGO_MAX_UPLOAD_SIZE=5242880

# Storefront origin(s) allowed to call this API. Production: your Vercel URL only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Optional. Unset = sqlite at backend/db.sqlite3.
# Render/Railway/Fly example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DATABASE_SSL_REQUIRE=false
DATABASE_CONN_MAX_AGE=600

# Image storage: set Cloudinary to use HTTPS CDN URLs.
# Without these, uploads go to backend/media/ (DEBUG serves /media/).
# Local disk on Render/Railway/Fly is ephemeral and will lose files on restart.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
